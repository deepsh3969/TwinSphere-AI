# TwinSphere AI — environment variables (copy to .env at the repo root and adjust)
# NEVER commit real secrets. Loaded automatically by the backend (python-dotenv).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default (when unset): SQLite file at backend/twinsphere.db — zero-setup dev.
# DATABASE_URL=sqlite:///./twinsphere.db
#
# PostgreSQL (docker compose --profile postgres up — POSTGRES_PASSWORD is required
# and the port is bound to 127.0.0.1 only):
# DATABASE_URL=postgresql+psycopg2://twin:${POSTGRES_PASSWORD}@localhost:5432/twinsphere

# ---------------------------------------------------------------------------
# Security (Phase 10 — see docs/SECURITY.md)
# ---------------------------------------------------------------------------
# Strong unique secret (>= 32 chars). docker-compose REFUSES to start without it,
# and the backend refuses startup under APP_ENV=production while this is the
# development default. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# JWT_ISSUER=twinsphere
# JWT_AUDIENCE=twinsphere-api

# Environment profile:
#   development  — local work; demo users + registration on; dev secret warns
#   test         — pytest/smoke; rate limiting off (set by conftest)
#   demo         — presentation: demo users on, registration off, rate limiting
#                  relaxed, deterministic seed enforced
#   production   — strict secret/CORS validation; demo users + registration off
APP_ENV=development

# CORS (comma separated explicit origins; a wildcard "*" fails startup)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Phase 10 gates — default true in development, false under APP_ENV=production.
# /api/auth/demo returns usernames+roles only (never passwords) while enabled.
DEMO_USERS_ENABLED=true
REGISTRATION_ENABLED=true

# In-memory fixed-window limiter (disable ONLY for tests). Per-minute buckets:
# LOGIN 20 (keyed by IP and IP|username) · REGISTER 5 · EXPORT 30 · AI 20 ·
# SIMULATION 30 · ADMIN 60 · WS 60 · general RATE_LIMIT_PER_MINUTE (120).
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=20
REGISTER_RATE_LIMIT_PER_MINUTE=5
EXPORT_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_MINUTE=20
SIMULATION_RATE_LIMIT_PER_MINUTE=30
ADMIN_RATE_LIMIT_PER_MINUTE=60
WS_RATE_LIMIT_PER_MINUTE=60

# Transport hardening. HSTS must stay false on plain-HTTP local dev — enable it
# only when serving over TLS. SECURITY_HEADERS adds nosniff/frame/referrer/
# permissions-policy/CSP + X-Request-ID and enforces the body-size cap.
HSTS_ENABLED=false
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1000000
# WS_AUTH_TIMEOUT_S=10.0

# First-admin bootstrap CLI (refuses dev JWT_SECRET defaults):
#   BOOTSTRAP_ADMIN_PASSWORD=<strong> python -m app.services.bootstrap_admin --username admin --email you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional LLM for the AI Analyst
# (falls back to the local deterministic analyst when empty)
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Phase 8 — AI Analyst call budget. LLM_TIMEOUT caps one LLM call (seconds);
# on timeout/error/malformed output the deterministic fallback is used so the
# platform never blocks. LLM_MAX_TOKENS bounds the narrative JSON reply.
LLM_TIMEOUT=12
LLM_MAX_TOKENS=900

# Minimum wall-clock seconds between two triggered analyst refreshes. The
# context signature cache already suppresses unchanged-state runs; the
# cooldown stops risk-flap churn. CRITICAL severity / ACTIVE evacuation
# bypasses it after 5 seconds. POST /api/ai/analyze always bypasses.
ANALYST_COOLDOWN_SECONDS=15

# ---------------------------------------------------------------------------
# Simulation tuning
# ---------------------------------------------------------------------------
SENSOR_TICK_SECONDS=2.0
SIM_TICK_SECONDS=1.0
SIMULATION_SPEED=1.0
RANDOM_SEED=42
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase 4 — realtime simulation & WebSocket streaming
# ---------------------------------------------------------------------------
# Master switch for the live sensor simulation runtime. When false the
# simulator starts STOPPED and the /ws endpoint refuses connections (1013).
SIMULATION_ENABLED=true

# How often tick telemetry is persisted to sensor_readings (seconds).
# Cadence = interval / SENSOR_TICK_SECONDS ticks; 0 disables batched writes.
SIMULATION_PERSIST_INTERVAL=20.0

# Optional dedicated seed for the realtime simulator. Falls back to RANDOM_SEED.
# SIMULATION_SEED=42

# Set to false to disable the /ws WebSocket endpoint entirely (REST still works).
WEBSOCKET_ENABLED=true

# ---------------------------------------------------------------------------
# Phase 5 — AI anomaly detection, prediction & risk intelligence
# ---------------------------------------------------------------------------
# Master switch for the AI analysis scheduler (anomalies, predictions, risk).
# When false the backend, simulation and WebSocket keep running unchanged.
AI_ENABLED=true

# Wall-clock seconds between AI analysis cycles (anomaly -> prediction -> risk
# -> persistence -> ai.*/risk.* WebSocket events).
AI_ANALYSIS_INTERVAL_SECONDS=15

# Minimum sensor history samples before statistical (L2/L3) anomaly detection
# engages. Below this a sensor reports status INSUFFICIENT_DATA; hard domain
# threshold breaches (L1) are still reported immediately.
ANOMALY_MIN_SAMPLES=30

# Minimum 0-100 anomaly score required to RAISE a new anomaly. Threshold
# breaches always score >= 60 so they raise instantly; rolling z-score and
# Isolation Forest detections must be this strong to reduce false positives.
ANOMALY_SCORE_THRESHOLD=60

# Upper bound on concurrently tracked anomalies (oldest/lowest drop out).
ANOMALY_MAX_TRACKED=50

# Minimum series samples before the RandomForest models train. Below this the
# service uses the deterministic seasonal baseline and labels it model=BASELINE.
PREDICTION_MIN_SAMPLES=100

# Seconds between model retrains (predictions themselves refresh every AI cycle).
PREDICTION_RETRAIN_SECONDS=600

# Comma-separated forecast horizons in minutes.
PREDICTION_HORIZONS=15,30,60

# Directory for persisted joblib model artifacts (created on demand, gitignored).
# MODEL_DIR=ai/models

# Risk smoothing: exponential moving average factor (0..1) applied to the raw
# weighted risk score, plus a minimum change (points) before a new value is
# published — together they prevent level flapping.
RISK_SMOOTHING_ALPHA=0.35
RISK_MIN_DELTA=1.0

# ---------------------------------------------------------------------------
# Frontend (Vite) — only needed when the UI is served separately from the API.
# Leave unset in local dev: the Vite dev server proxies /api, /health and /ws.
# ---------------------------------------------------------------------------
# VITE_API_URL=
# VITE_WS_URL=
